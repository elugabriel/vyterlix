# Vyterlix production settings. Copy to /etc/vyterlix/vyterlix.env on the server (owner vyterlix,
# mode 600). Replace every CHANGE-ME. This file holds NO real secrets; never put real ones in git.
#
# Make a secret:   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Make an encryption key (must be Fernet-style, 32 url-safe base64 bytes):
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

VYTERLIX_ENV=prod
VYTERLIX_LOG_LEVEL=INFO

# The database lives on the same server and only listens on localhost.
VYTERLIX_DATABASE_URL=postgresql+psycopg://vyterlix:CHANGE-ME@127.0.0.1:5432/vyterlix

# One address for the website and the API (nginx sends /api/ to the app), so there is no cross-site
# traffic and the sign-in cookie stays on one site.
VYTERLIX_FRONTEND_BASE_URL=https://vyterlix.com
VYTERLIX_CORS_ORIGINS='["https://vyterlix.com"]'
VYTERLIX_COOKIE_SECURE=true

# Sign-in tokens and the key that locks connection tokens (Xero, Google...). Keep a copy of the
# encryption key somewhere safe and OFF the server: without it, saved connections cannot be read.
VYTERLIX_JWT_SECRET=CHANGE-ME
VYTERLIX_ENCRYPTION_KEY=CHANGE-ME

# Uploaded files (outside the code folder; included in backups).
VYTERLIX_UPLOAD_DIR=/var/lib/vyterlix/uploads

# Email: any SMTP provider. Production refuses the console backend.
VYTERLIX_EMAIL_BACKEND=smtp
VYTERLIX_SMTP_HOST=smtp.hostinger.com
VYTERLIX_SMTP_PORT=587
VYTERLIX_SMTP_USERNAME=admin@vyterlix.com
VYTERLIX_SMTP_PASSWORD=CHANGE-ME
VYTERLIX_EMAIL_FROM='Vyterlix <admin@vyterlix.com>'

# Payments (leave out until the accounts exist).
# VYTERLIX_STRIPE_SECRET_KEY=
# VYTERLIX_STRIPE_WEBHOOK_SECRET=

# Connections to other systems. Redirect address to register with every provider:
#   https://vyterlix.com/integrations-callback.html
# VYTERLIX_XERO_CLIENT_ID=
# VYTERLIX_XERO_CLIENT_SECRET=
# VYTERLIX_QUICKBOOKS_CLIENT_ID=
# VYTERLIX_QUICKBOOKS_CLIENT_SECRET=
VYTERLIX_QUICKBOOKS_ENVIRONMENT=production
# VYTERLIX_ZOHO_CLIENT_ID=
# VYTERLIX_ZOHO_CLIENT_SECRET=
VYTERLIX_ZOHO_REGION=eu
# VYTERLIX_GOOGLE_CLIENT_ID=
# VYTERLIX_GOOGLE_CLIENT_SECRET=
# VYTERLIX_TRUELAYER_CLIENT_ID=
# VYTERLIX_TRUELAYER_CLIENT_SECRET=
VYTERLIX_TRUELAYER_ENVIRONMENT=live
VYTERLIX_SQUARE_ENVIRONMENT=production

# The AI assistant works offline unless this is set.
VYTERLIX_AI_PROVIDER=offline

# Where this API is reached from outside (WhatsApp is told this address).
VYTERLIX_PUBLIC_API_URL=https://vyterlix.com
