# Copy to backend/.env and adjust. Never commit the real .env.
VYTERLIX_ENV=dev
VYTERLIX_LOG_LEVEL=INFO

# Local PostgreSQL install:
VYTERLIX_DATABASE_URL=postgresql+psycopg://vyterlix:vyterlix@localhost:5432/vyterlix

# JSON list of allowed frontend origins. Must match deployed frontend exactly in prod.
VYTERLIX_CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]

# Base URL of the frontend, used for links in emails (verify email, reset password).
VYTERLIX_FRONTEND_BASE_URL=http://localhost:5500

# "console" writes emails (including their links) to the API log instead of sending them.
# Dev/test only — refused when VYTERLIX_ENV=prod.
VYTERLIX_EMAIL_BACKEND=console
VYTERLIX_EMAIL_FROM=Vyterlix <no-reply@vyterlix.com>
VYTERLIX_EMAIL_VERIFICATION_TTL_HOURS=24
VYTERLIX_TOKEN_RESEND_COOLDOWN_SECONDS=60

# Signs access tokens. The dev default is public — staging/prod refuse to start without
# a random 32+ character value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# VYTERLIX_JWT_SECRET=
VYTERLIX_ACCESS_TOKEN_TTL_MINUTES=15
VYTERLIX_REFRESH_TOKEN_TTL_DAYS=30
VYTERLIX_COOKIE_SECURE=true

# Failed-login limits within a rolling window.
VYTERLIX_LOGIN_FAILURE_WINDOW_MINUTES=15
VYTERLIX_LOGIN_MAX_FAILURES_PER_EMAIL=5
VYTERLIX_LOGIN_MAX_FAILURES_PER_IP=20
