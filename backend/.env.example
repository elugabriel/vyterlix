# Copy to backend/.env and adjust. Never commit the real .env.
VYTERLIX_ENV=dev
VYTERLIX_LOG_LEVEL=INFO

# Local PostgreSQL install:
VYTERLIX_DATABASE_URL=postgresql+psycopg://vyterlix:vyterlix@localhost:5432/vyterlix

# JSON list of allowed frontend origins. Must match deployed frontend exactly in prod.
VYTERLIX_CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]
